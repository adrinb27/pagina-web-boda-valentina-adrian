# Docker build context excludes - keep the image small and the build fast.

# Dependencies (regenerated by `npm ci` inside the build stage)
node_modules

# Version control / tooling
.git
.gitignore
.github
.vscode
.specify
specs

# Large source artifacts NOT used by the served site
bogota.mp4
*.psd
psd

# Docker + docs (not needed inside the image)
Dockerfile
docker-compose.yml
.dockerignore
README.md
LICENSE
CNAME
npmfile.js

# Windows "mark of the web" metadata surfaced by WSL
**/*:Zone.Identifier
